--!strict
-- BuildGuideStore: the live build-guide store. Merges BUILT-IN guides (produced by the train-recipe
-- factory, embedded as JSON strings in BuiltinBuildGuides — generated by gen_builtin_buildguides.py) with
-- USER guides (self/user-authored, persisted via plugin:SetSetting — same mechanism as SkillStore/Memory).
-- Decodes + validates built-ins ONCE at construction; a malformed one is dropped + warned (never crashes).
-- One instance in deps.buildGuides. catalogBlock() rides the leading preamble (always-on);
-- resolve(category) backs use_build_guide; save/delete back save_build_guide/delete_build_guide. Built-in
-- modules are RESERVED (save rejects a collision; delete refuses a built-in). User guides are GLOBAL-scope.
-- Mirrors SkillStore.

local HttpService = game:GetService("HttpService")

local BuildGuideCatalog = require(script.Parent.BuildGuideCatalog)
local BuiltinBuildGuides = require(script.Parent.BuiltinBuildGuides)

type Guide = BuildGuideCatalog.Guide

local BuildGuideStore = {}
BuildGuideStore.__index = BuildGuideStore

local SETTING_PREFIX = "StudioAgent_"
local USER_KEY = SETTING_PREFIX .. "buildguides_user"

export type BuildGuideStore = typeof(setmetatable(
	{} :: {
		_plugin: Plugin?,
		_builtins: { Guide },
		_builtinModules: { [string]: boolean },
	},
	BuildGuideStore
))

local function buildBuiltins(): ({ Guide }, { [string]: boolean })
	local out: { Guide } = {}
	local seen: { [string]: boolean } = {}
	for _, jsonText in ipairs(BuiltinBuildGuides.list :: { any }) do
		if type(jsonText) == "string" then
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(jsonText)
			end)
			if ok then
				local guide, err = BuildGuideCatalog.validateGuide(decoded)
				if guide ~= nil and not seen[guide.module] then
					seen[guide.module] = true
					table.insert(out, guide)
				elseif guide == nil then
					warn("[StudioAgent] skipping malformed built-in build guide: " .. tostring(err))
				end
			else
				warn("[StudioAgent] skipping unparseable built-in build guide JSON")
			end
		end
	end
	return out, seen
end

-- plugin is optional so a child/test context (no persistence) still gets the built-ins.
function BuildGuideStore.new(plugin: Plugin?): BuildGuideStore
	local builtins, modules = buildBuiltins()
	return setmetatable(
		{ _plugin = plugin, _builtins = builtins, _builtinModules = modules },
		BuildGuideStore
	)
end

-- Re-validate persisted user guides defensively (a corrupt/old blob can't inject junk); drop a module that
-- collides with a built-in or a duplicate.
function BuildGuideStore.loadUser(self: BuildGuideStore): { Guide }
	if self._plugin == nil then
		return {}
	end
	local raw = (self._plugin :: Plugin):GetSetting(USER_KEY)
	local out: { Guide } = {}
	if type(raw) == "table" then
		local seen: { [string]: boolean } = {}
		for _, e in ipairs(raw :: { any }) do
			local guide = BuildGuideCatalog.validateGuide(e)
			if guide ~= nil and not self._builtinModules[guide.module] and not seen[guide.module] then
				seen[guide.module] = true
				table.insert(out, guide)
			end
		end
	end
	while #out > BuildGuideCatalog.MAX_USER_GUIDES do
		table.remove(out, 1)
	end
	return out
end

-- Built-ins first, then user. Used by the catalog + lookup.
function BuildGuideStore.all(self: BuildGuideStore): { Guide }
	local out: { Guide } = {}
	for _, g in ipairs(self._builtins) do
		table.insert(out, g)
	end
	for _, g in ipairs(self:loadUser()) do
		table.insert(out, g)
	end
	return out
end

-- Persist the user list in a raw shape validateGuide re-accepts (so coverage survives a round-trip).
local function persistUser(self: BuildGuideStore, guides: { Guide })
	if self._plugin == nil then
		return
	end
	local raw: { any } = {}
	for _, g in ipairs(guides) do
		local entry: { [string]: any } = {
			module = g.module,
			version = g.version,
			system_module = g.system_module,
			rubric_version = g.rubric_version,
			overview = g.overview,
			killer_systems = g.killer_systems,
			tiers = g.tiers,
			common_pitfalls = g.common_pitfalls,
		}
		if g.coverage ~= nil then
			entry.provenance = {
				coverage = {
					criteria_total = g.coverage.total,
					criteria_addressed = g.coverage.addressed,
				},
			}
		end
		table.insert(raw, entry)
	end
	(self._plugin :: Plugin):SetSetting(USER_KEY, raw)
end

-- Save a user build guide from a RAW (decoded) guide table. Validates, rejects a built-in-module collision,
-- updates-or-inserts, FIFO-caps. Returns (note, ok).
function BuildGuideStore.save(self: BuildGuideStore, rawGuide: any): (string, boolean)
	if self._plugin == nil then
		return "save_build_guide is not available here (no persistence in this context)", false
	end
	local guide, err = BuildGuideCatalog.validateGuide(rawGuide)
	if guide == nil then
		return "save_build_guide failed: " .. tostring(err), false
	end
	local users = self:loadUser()
	local out, note, ok = BuildGuideCatalog.saveInto(users, guide, self._builtinModules)
	if ok then
		persistUser(self, out)
	end
	return note, ok
end

-- Delete a USER build guide by module/category. Refuses a built-in. Returns (note, ok).
function BuildGuideStore.delete(self: BuildGuideStore, category: any): (string, boolean)
	if self._plugin == nil then
		return "delete_build_guide is not available here", false
	end
	local target = BuildGuideCatalog.normalizeCategory(category)
	if target ~= nil and self._builtinModules[target] then
		return "delete_build_guide: '" .. target .. "' is a built-in build guide and can't be deleted.",
			false
	end
	local users = self:loadUser()
	local out, note, ok = BuildGuideCatalog.deleteFrom(users, category)
	if ok then
		persistUser(self, out)
	end
	return note, ok
end

-- The always-on catalog injected into the leading preamble (built-ins + user).
function BuildGuideStore.catalogBlock(self: BuildGuideStore): string
	return BuildGuideCatalog.catalogBlock(self:all())
end

-- Resolve a category into the full guide text use_build_guide returns. (text, ok).
function BuildGuideStore.resolve(self: BuildGuideStore, category: any): (string, boolean)
	local guide = BuildGuideCatalog.findByCategory(self:all(), category)
	if guide == nil then
		local names: { string } = {}
		for _, g in ipairs(self:all()) do
			table.insert(names, g.module)
		end
		local avail = if #names > 0 then table.concat(names, ", ") else "(none)"
		return "unknown build guide '" .. tostring(category) .. "'. Available: " .. avail, false
	end
	return BuildGuideCatalog.render(guide), true
end

return BuildGuideStore
