--!strict
-- bind_grip_motor: the RUNTIME weld->Motor6D grip swap + spin verb (the queued headline mechanic).
-- At runtime Humanoid:EquipTool welds the Tool with an unscriptable "RightGrip" Weld -- the edit-mode
-- AgentEditGrip motor never exists in play, so runtime clips/mechanics have no grip pose channel.
-- This tool stamps the config as Tool attributes + a SERVER Script (bind_behavior pattern: thin
-- launcher requiring the git-versioned GripMotorRuntime library module; legacy full source when the
-- sidecar is down) that swaps the weld for an "AgentGripMotor" Motor6D on every equip and drives the
-- SPIN verb (GripSpin attribute -> C0 rotation per Heartbeat -- the blocking mechanic). Composes
-- with bind_behavior (states) and bind_hitbox (damage windows). Destructive; RELAY; parent-only.

local ChangeHistoryService = game:GetService("ChangeHistoryService")
local RunService = game:GetService("RunService")

local RuntimeInstaller = require(script.Parent.Parent.RuntimeInstaller)
local Path = require(script.Parent.Path)

local ItemGripMotor = {}

export type Descriptor = {
	name: string,
	description: string,
	inputSchema: { [string]: any },
	destructive: boolean,
	run: (input: any, context: any) -> (any, boolean),
}

-- LEGACY FALLBACK source, stamped in full ONLY when the runtime library is unavailable (sidecar
-- down). Canonical logic lives in repo runtime/GripMotorRuntime.luau. Keep in sync. ASCII-only.
local RUNTIME_SOURCE = [==[
-- ItemGripMotorRuntime (auto-generated by bind_grip_motor) -- SERVER-side weld->Motor6D grip swap.
local Tool = script.Parent
local RunService = game:GetService("RunService")
local motor = nil
local restC0 = nil
local spinConn = nil

local function stopSpin()
	if spinConn ~= nil then
		spinConn:Disconnect()
		spinConn = nil
	end
	if motor ~= nil and motor.Parent ~= nil and restC0 ~= nil then
		motor.C0 = restC0
	end
end

local function startSpin()
	if spinConn ~= nil or motor == nil or motor.Parent == nil then
		return
	end
	local axisName = Tool:GetAttribute("GripSpinAxis")
	local axis = Vector3.xAxis
	if axisName == "Y" then
		axis = Vector3.yAxis
	elseif axisName == "Z" then
		axis = Vector3.zAxis
	end
	spinConn = RunService.Heartbeat:Connect(function(dt)
		if motor == nil or motor.Parent == nil then
			stopSpin()
			return
		end
		local speed = tonumber(Tool:GetAttribute("GripSpinSpeed")) or 720
		motor.C0 = motor.C0 * CFrame.fromAxisAngle(axis, math.rad(speed * dt))
	end)
end

local function swapWeld(char)
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	if hand == nil then
		return
	end
	local weld = hand:FindFirstChild("RightGrip") or hand:WaitForChild("RightGrip", 2)
	if weld == nil or not weld:IsA("JointInstance") then
		return
	end
	local m = Instance.new("Motor6D")
	m.Name = "AgentGripMotor"
	m.Part0 = weld.Part0
	m.Part1 = weld.Part1
	m.C0 = weld.C0
	m.C1 = weld.C1
	weld:Destroy()
	m.Parent = hand
	motor = m
	restC0 = m.C0
	Tool:SetAttribute("GripMotorLive", true)
	if Tool:GetAttribute("GripSpin") == true then
		startSpin()
	end
end

Tool.Equipped:Connect(function()
	local char = Tool.Parent
	if char ~= nil then
		task.defer(swapWeld, char)
	end
end)

Tool.Unequipped:Connect(function()
	stopSpin()
	if motor ~= nil then
		motor:Destroy()
		motor = nil
	end
	restC0 = nil
	Tool:SetAttribute("GripMotorLive", false)
end)

Tool:GetAttributeChangedSignal("GripSpin"):Connect(function()
	if Tool:GetAttribute("GripSpin") == true then
		startSpin()
	else
		stopSpin()
	end
end)

if Tool.Parent ~= nil and Tool.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
	task.defer(swapWeld, Tool.Parent)
end
]==]

local AXES = { X = true, Y = true, Z = true }

local function findTool(args: any): (Tool?, string?)
	if type(args.tool) ~= "string" or args.tool == "" then
		return nil, "bind_grip_motor requires { tool = <path to a Tool>, spinSpeed?, spinAxis?, spin? }"
	end
	local inst = Path.resolve(args.tool)
	if inst == nil or not inst:IsA("Tool") then
		return nil, "'" .. tostring(args.tool) .. "' is not a Tool (run make_tool first)"
	end
	return inst :: Tool, nil
end

-- Write the runtime Script (SERVER-side -- a plain Script, unlike bind_behavior's LocalScript).
local function writeRuntime(tool: Tool, useLibrary: boolean)
	local old = tool:FindFirstChild("ItemGripMotorRuntime")
	if old ~= nil then
		old:Destroy()
	end
	local s = Instance.new("Script")
	s.Name = "ItemGripMotorRuntime"
	s.Source = if useLibrary
		then RuntimeInstaller.launcherSource("GripMotorRuntime")
		else RUNTIME_SOURCE
	s:SetAttribute("StudioAgentGenerated", true) -- identity marker: game_pull excludes on this
	s.Parent = tool
end

local function runBind(input: any, context: any): (any, boolean)
	local args = if type(input) == "table" then input else {}
	local tool, terr = findTool(args)
	if tool == nil then
		return terr, true
	end
	local theTool = tool :: Tool
	local speed = if type(args.spinSpeed) == "number"
		then math.clamp(args.spinSpeed, 30, 3600)
		else 720
	local axis = if type(args.spinAxis) == "string" and AXES[string.upper(args.spinAxis)]
		then string.upper(args.spinAxis)
		else "X"
	local spin = args.spin == true

	-- Library install OUTSIDE the undo recording (Ctrl+Z of one bind must not strip the library).
	local libOk, libNote = RuntimeInstaller.ensureInstalled(
		if type(context) == "table" then context.config else nil,
		{ "GripMotorRuntime" }
	)
	local function doBind()
		theTool:SetAttribute("GripSpinSpeed", speed)
		theTool:SetAttribute("GripSpinAxis", axis)
		theTool:SetAttribute("GripSpin", spin)
		theTool:SetAttribute("GripMotorLive", false)
		writeRuntime(theTool, libOk)
	end
	if RunService:IsEdit() then
		local rid = ChangeHistoryService:TryBeginRecording("bind_grip_motor")
		doBind()
		if rid ~= nil then
			ChangeHistoryService:FinishRecording(rid, Enum.FinishRecordingOperation.Commit)
		end
	else
		doBind()
	end

	local msg = string.format(
		"bind_grip_motor OK: %s now swaps the engine's RightGrip WELD for an 'AgentGripMotor' Motor6D "
			.. "on every runtime equip (C0/C1 copied from the weld -- the stamped-grip fit carries over; "
			.. "GripMotorLive attribute mirrors the swap). SPIN VERB: set the Tool's GripSpin attribute "
			.. "true/false at runtime -- spins about %s at %d deg/s (GripSpinSpeed/GripSpinAxis attributes, "
			.. "live-tunable); rest C0 restores exactly on stop. The motor's pose channel matches "
			.. "edit-authored Handle clips (Animator matches by Part1 name). SERVER-side; verify in a "
			.. "playtest (edit mode never creates the engine weld).",
		theTool.Name,
		axis,
		speed
	)
	msg ..= " ["
		.. (if libOk then libNote else "runtime library unavailable -- stamped the legacy full source (" .. libNote .. ")")
		.. "]"
	return msg, false
end

ItemGripMotor.descriptors = {
	{
		name = "bind_grip_motor",
		description = "Give a Tool a RUNTIME GRIP MOTOR: at play time Humanoid:EquipTool welds the Tool "
			.. "with an unscriptable 'RightGrip' Weld -- this binds a SERVER runtime that swaps that weld "
			.. "for an 'AgentGripMotor' Motor6D (same C0/C1, so the fitted grip carries over) on every "
			.. "equip, making the runtime grip an animatable/drivable pose channel (matches edit-authored "
			.. "Handle clips). Includes the SPIN verb: setting the Tool's GripSpin attribute true spins the "
			.. "weapon about GripSpinAxis at GripSpinSpeed deg/s (Heartbeat C0 rotation -- the blocking "
			.. "mechanic); false restores the rest hold exactly. Inputs: tool (required path), spinSpeed? "
			.. "(deg/s, default 720, clamp 30-3600), spinAxis? ('X'|'Y'|'Z', default 'X'), spin? (start "
			.. "spinning immediately, default false). Composes with bind_behavior/bind_hitbox. Effects are "
			.. "RUNTIME-only -- verify in a playtest.",
		inputSchema = {
			type = "object",
			properties = {
				tool = { type = "string", description = "Path to the Tool (from make_tool)." },
				spinSpeed = {
					type = "number",
					description = "Spin speed in degrees/second (default 720; clamped 30-3600).",
				},
				spinAxis = {
					type = "string",
					description = "Hand-space spin axis: 'X' (default, propeller block), 'Y', or 'Z'.",
				},
				spin = {
					type = "boolean",
					description = "Start spinning immediately on equip (default false).",
				},
			},
			required = { "tool" },
		},
		destructive = true,
		run = runBind,
	},
} :: { Descriptor }

return ItemGripMotor
