--!strict
-- Item behavior state machine (roadmap #3): bind_behavior(tool, windup?, active?, cooldown?) gives a Tool a
-- timed on-activate sequence -- windup -> active -> cooldown -> idle -- driving WHEN the use clip plays and
-- exposing the ACTIVE WINDOW (where #4 hit detection fires). Writes the durations as Tool Attributes + a client
-- ItemBehaviorRuntime LocalScript that supersedes ItemAnimRuntime (it does both animation + the state machine)
-- and reuses #2's Anims/idle+Anims/use clips. State is exposed via the `ItemState` attribute + a `StateChanged`
-- BindableEvent. Destructive (DataModel writes); RELAY; parent-only.
-- See docs/superpowers/specs/2026-06-26-item-behavior-state-machine-design.md.

local ChangeHistoryService = game:GetService("ChangeHistoryService")
local RunService = game:GetService("RunService")

local BehaviorFactory = require(script.Parent.Parent.BehaviorFactory)
local RuntimeInstaller = require(script.Parent.Parent.RuntimeInstaller)
local Path = require(script.Parent.Path)

local ItemBehavior = {}

export type Descriptor = {
	name: string,
	description: string,
	inputSchema: { [string]: any },
	destructive: boolean,
	run: (input: any, context: any) -> (any, boolean),
}

-- LEGACY FALLBACK source, stamped in full ONLY when the runtime library is unavailable (sidecar
-- down). The canonical logic now lives in the git-versioned library (repo runtime/BehaviorRuntime.luau,
-- installed as ReplicatedStorage.StudioAgentRuntime by RuntimeInstaller); the normal write is a thin
-- launcher that require()s it. Keep this in sync with the library on meaningful changes. ASCII-only.
local RUNTIME_SOURCE = [==[
-- ItemBehaviorRuntime (auto-generated by bind_behavior) -- CLIENT-side Tool state machine + animation.
-- Supersedes ItemAnimRuntime. Dev-loop playback uses RegisterKeyframeSequence (solo Studio only); a
-- shipped/multiplayer item needs a published AnimationId + server-authoritative validation (later).
local Tool = script.Parent
local KSP = game:GetService("KeyframeSequenceProvider")
local stateChanged = Tool:FindFirstChild("StateChanged")
local tracks = {}
local token = 0

local function getAnimator()
	local char = Tool.Parent
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	return animator
end

local function play(clipName, looped, priority)
	local prev = tracks[clipName]
	if prev then
		pcall(function()
			prev:Stop()
		end)
		tracks[clipName] = nil
	end
	local anims = Tool:FindFirstChild("Anims")
	local ks = anims and anims:FindFirstChild(clipName)
	if not ks then
		return
	end
	local animator = getAnimator()
	if not animator then
		return
	end
	local ok, id = pcall(function()
		return KSP:RegisterKeyframeSequence(ks)
	end)
	if not ok or type(id) ~= "string" then
		return
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local track = animator:LoadAnimation(anim)
	track.Looped = looped
	track.Priority = priority
	track:Play()
	tracks[clipName] = track
end

local function setState(s)
	Tool:SetAttribute("ItemState", s)
	if stateChanged then
		pcall(function()
			stateChanged:Fire(s)
		end)
	end
end

local function enterIdle()
	setState("idle")
	play("idle", true, Enum.AnimationPriority.Idle)
end

Tool.Equipped:Connect(function()
	enterIdle()
end)

Tool.Activated:Connect(function()
	if Tool:GetAttribute("ItemState") ~= "idle" then
		return
	end
	token += 1
	local my = token
	local windup = tonumber(Tool:GetAttribute("BehaviorWindup")) or 0.15
	local active = tonumber(Tool:GetAttribute("BehaviorActive")) or 0.15
	local cooldown = tonumber(Tool:GetAttribute("BehaviorCooldown")) or 0.4
	setState("windup")
	play("use", false, Enum.AnimationPriority.Action)
	task.wait(windup)
	if my ~= token then
		return
	end
	setState("active")
	task.wait(active)
	if my ~= token then
		return
	end
	setState("cooldown")
	task.wait(cooldown)
	if my ~= token then
		return
	end
	enterIdle()
end)

Tool.Unequipped:Connect(function()
	token += 1
	for _, t in tracks do
		pcall(function()
			t:Stop()
		end)
	end
	tracks = {}
	Tool:SetAttribute("ItemState", "idle")
end)

-- Heal a missed first equip (script started while the tool is already in a character).
if Tool.Parent ~= nil and Tool.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
	enterIdle()
end
]==]

local function findTool(args: any): (Tool?, string?)
	if type(args.tool) ~= "string" or args.tool == "" then
		return nil,
			"bind_behavior requires { tool = <path to a Tool>, windup?, active?, cooldown? } (seconds)"
	end
	local inst = Path.resolve(args.tool)
	if inst == nil or not inst:IsA("Tool") then
		return nil, "'" .. tostring(args.tool) .. "' is not a Tool (run make_tool first)"
	end
	return inst :: Tool, nil
end

-- Ensure a StateChanged BindableEvent child (the decoupled hook #4 connects to).
local function ensureStateEvent(tool: Tool)
	local ev = tool:FindFirstChild("StateChanged")
	if ev == nil or not ev:IsA("BindableEvent") then
		if ev ~= nil then
			ev:Destroy()
		end
		local b = Instance.new("BindableEvent")
		b.Name = "StateChanged"
		b.Parent = tool
	end
end

-- Write the runtime (replacing any prior ItemBehaviorRuntime AND the superseded ItemAnimRuntime).
-- useLibrary -> a thin launcher requiring StudioAgentRuntime.BehaviorRuntime; else the legacy full source.
local function writeRuntime(tool: Tool, useLibrary: boolean)
	for _, n in { "ItemBehaviorRuntime", "ItemAnimRuntime" } do
		local old = tool:FindFirstChild(n)
		if old ~= nil then
			old:Destroy()
		end
	end
	local ls = Instance.new("LocalScript")
	ls.Name = "ItemBehaviorRuntime"
	ls.Source = if useLibrary
		then RuntimeInstaller.launcherSource("BehaviorRuntime")
		else RUNTIME_SOURCE
	ls.Parent = tool
end

local function runBind(input: any, context: any): (any, boolean)
	local args = if type(input) == "table" then input else {}
	local tool, terr = findTool(args)
	if tool == nil then
		return terr, true
	end
	local cfg, cerr = BehaviorFactory.validate({
		windup = args.windup,
		active = args.active,
		cooldown = args.cooldown,
	})
	if cerr ~= nil then
		return "bind_behavior: " .. cerr, true
	end
	local theTool = tool :: Tool
	local hasUse = (function()
		local anims = theTool:FindFirstChild("Anims")
		return anims ~= nil and anims:FindFirstChild("use") ~= nil
	end)()

	-- Install/refresh the shared library OUTSIDE the bind's undo recording: Ctrl+Z of one bind
	-- must not strip the library other tools' launchers require. Fail-open -> legacy stamped source.
	local libOk, libNote = RuntimeInstaller.ensureInstalled(
		if type(context) == "table" then context.config else nil,
		{ "BehaviorRuntime" }
	)
	local function doBind()
		theTool:SetAttribute("BehaviorWindup", cfg.windup)
		theTool:SetAttribute("BehaviorActive", cfg.active)
		theTool:SetAttribute("BehaviorCooldown", cfg.cooldown)
		theTool:SetAttribute("ItemState", "idle")
		ensureStateEvent(theTool)
		writeRuntime(theTool, libOk)
	end
	if RunService:IsEdit() then
		local rid = ChangeHistoryService:TryBeginRecording("bind_behavior")
		doBind()
		if rid ~= nil then
			ChangeHistoryService:FinishRecording(rid, Enum.FinishRecordingOperation.Commit)
		end
	else
		doBind()
	end

	local aStart, aEnd = BehaviorFactory.activeWindow(cfg)
	local msg = string.format(
		"bind_behavior OK: %s now runs windup(%.2fs) -> active(%.2fs) -> cooldown(%.2fs) -> idle on activate "
			.. "(wrote ItemBehaviorRuntime, superseding ItemAnimRuntime). ACTIVE WINDOW = [%.2fs, %.2fs] after "
			.. "activate -- the effect/hitbox window (#4 connects StateChanged or reads ItemState=='active'). "
			.. "Re-activation during windup/active/cooldown is ignored. State on the Tool: ItemState attribute "
			.. "+ StateChanged BindableEvent.",
		theTool.Name,
		cfg.windup,
		cfg.active,
		cfg.cooldown,
		aStart,
		aEnd
	)
	if not hasUse then
		msg = msg
			.. " WARNING: the Tool has no Anims/use clip yet -- the swing won't animate until "
			.. "bind_animation(tool, 'use', <clip>). Author the idle/use clips first."
	end
	msg = msg
		.. " NOTE: dev-loop playback is Studio-solo (RegisterKeyframeSequence); shipping needs a published "
		.. "AnimationId + server-authoritative hit validation (later)."
	msg ..= " ["
		.. (if libOk then libNote else "runtime library unavailable — stamped the legacy full source (" .. libNote .. ")")
		.. "]"
	return msg, false
end

ItemBehavior.descriptors = {
	{
		name = "bind_behavior",
		description = "Give a handheld Tool a BEHAVIOR STATE MACHINE: on activate it runs a timed sequence "
			.. "windup -> active -> cooldown -> idle, driving when the use animation plays and exposing the "
			.. "ACTIVE WINDOW (where a hitbox/effect fires). Writes the durations as Tool Attributes "
			.. "(BehaviorWindup/Active/Cooldown, seconds) + a client ItemBehaviorRuntime that supersedes "
			.. "ItemAnimRuntime (it plays the idle/use clips from bind_animation AND runs the machine). State "
			.. "is exposed via the ItemState attribute + a StateChanged BindableEvent for hit detection (#4). "
			.. "Run AFTER bind_animation (needs the Anims/use clip to animate the swing). Inputs: tool "
			.. "(required path, from make_tool), windup? active? cooldown? (seconds; default 0.15/0.15/0.40). "
			.. "Re-activation while busy (windup/active/cooldown) is ignored -- that's the cooldown gate.",
		inputSchema = {
			type = "object",
			properties = {
				tool = { type = "string", description = "Path to the Tool (from make_tool)." },
				windup = {
					type = "number",
					description = "Telegraph seconds before the active window (default 0.15).",
				},
				active = {
					type = "number",
					description = "Seconds the effect/hitbox window is live (default 0.15).",
				},
				cooldown = {
					type = "number",
					description = "Recovery seconds before idle accepts activate again (default 0.40).",
				},
			},
			required = { "tool" },
		},
		destructive = true,
		run = runBind,
	},
} :: { Descriptor }

return ItemBehavior
