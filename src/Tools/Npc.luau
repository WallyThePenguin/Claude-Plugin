--!strict
-- PvE NPC AI (roadmap #5): make_npc(rig, ...) gives a rig (Humanoid + HumanoidRootPart) ENEMY AI -- a
-- server-side state machine idle -> chase -> attack (+ death), so the player's hit-detecting weapon (#1-4)
-- has a live opponent. Writes the AI config as Attributes + a server NpcAI Script (server-authoritative;
-- no client/replication complexity). Destructive (DataModel writes); RELAY; parent-only.
-- See docs/superpowers/specs/2026-06-26-pve-npc-ai-design.md.

local ChangeHistoryService = game:GetService("ChangeHistoryService")
local RunService = game:GetService("RunService")

local Path = require(script.Parent.Path)
local RuntimeInstaller = require(script.Parent.Parent.RuntimeInstaller)

local Npc = {}

export type Descriptor = {
	name: string,
	description: string,
	inputSchema: { [string]: any },
	destructive: boolean,
	run: (input: any, context: any) -> (any, boolean),
}

-- LEGACY FALLBACK source, stamped in full ONLY when the runtime library is unavailable. The
-- canonical logic lives in the git-versioned library (repo runtime/NpcAI.luau, installed by
-- RuntimeInstaller); the normal write is a thin launcher. Mirrors NpcBrain.decideState (kept in
-- sync; the pure module is spec-tested). ASCII-only.
local AI_SOURCE = [==[
-- NpcAI (auto-generated by make_npc) -- SERVER: perception-driven enemy state machine (idle/chase/attack),
-- server-authoritative. Dies when this Humanoid's Health hits 0 (e.g. killed by the player's #4 weapon).
local NPC = script.Parent
local Players = game:GetService("Players")
local hum = NPC:FindFirstChildOfClass("Humanoid")
local hrp = NPC:FindFirstChild("HumanoidRootPart")
if not (hum and hrp) then
	return
end

local function nearest()
	local best, bestDist = nil, nil
	for _, plr in Players:GetPlayers() do
		local c = plr.Character
		local thum = c and c:FindFirstChildOfClass("Humanoid")
		local thrp = c and c:FindFirstChild("HumanoidRootPart")
		if thum and thrp and thum.Health > 0 then
			local d = (thrp.Position - hrp.Position).Magnitude
			if bestDist == nil or d < bestDist then
				best, bestDist = c, d
			end
		end
	end
	return best, bestDist
end

local function decide(dist, detect, attack)
	if dist == nil then
		return "idle"
	end
	if dist <= attack then
		return "attack"
	end
	if dist <= detect then
		return "chase"
	end
	return "idle"
end

local lastAttack = 0
while hum.Health > 0 do
	local damage = tonumber(NPC:GetAttribute("NpcDamage")) or 15
	local detect = tonumber(NPC:GetAttribute("NpcDetectRange")) or 40
	local attack = tonumber(NPC:GetAttribute("NpcAttackRange")) or 6
	local cd = tonumber(NPC:GetAttribute("NpcAttackCooldown")) or 1.5
	local target, dist = nearest()
	local state = decide(dist, detect, attack)
	NPC:SetAttribute("NpcState", state)
	if state == "chase" and target then
		local thrp = target:FindFirstChild("HumanoidRootPart")
		if thrp then
			hum:MoveTo(thrp.Position)
		end
	elseif state == "attack" and target then
		hum:Move(Vector3.zero)
		if os.clock() - lastAttack >= cd then
			lastAttack = os.clock()
			local thum = target:FindFirstChildOfClass("Humanoid")
			if thum then
				thum:TakeDamage(damage)
			end
		end
	else
		hum:Move(Vector3.zero)
	end
	task.wait(0.2)
end
NPC:SetAttribute("NpcState", "dead")
]==]

local DEFAULTS = {
	damage = 15,
	detectRange = 40,
	attackRange = 6,
	attackCooldown = 1.5,
	speed = 12,
}

local function coerce(v: any, default: number): number
	if type(v) ~= "number" or v ~= v then
		return default
	end
	if v < 0 then
		return 0
	end
	return v
end

local function resolveRig(args: any): (Model?, string?)
	if type(args.rig) ~= "string" or args.rig == "" then
		return nil,
			"make_npc requires { rig = <path to a Model with a Humanoid> , damage?, detectRange?, attackRange?, attackCooldown?, speed? }"
	end
	local inst = Path.resolve(args.rig)
	if inst == nil or not inst:IsA("Model") then
		return nil, "'" .. tostring(args.rig) .. "' is not a Model (spawn_rig first)"
	end
	local m = inst :: Model
	if
		m:FindFirstChildOfClass("Humanoid") == nil
		or m:FindFirstChild("HumanoidRootPart") == nil
	then
		return nil,
			"'"
				.. tostring(args.rig)
				.. "' needs a Humanoid + HumanoidRootPart (spawn_rig makes one)"
	end
	return m, nil
end

local function runMake(input: any, context: any): (any, boolean)
	local args = if type(input) == "table" then input else {}
	local rig, rerr = resolveRig(args)
	if rig == nil then
		return rerr, true
	end
	local m = rig :: Model
	local damage = coerce(args.damage, DEFAULTS.damage)
	local detectRange = coerce(args.detectRange, DEFAULTS.detectRange)
	local attackRange = coerce(args.attackRange, DEFAULTS.attackRange)
	local attackCooldown = coerce(args.attackCooldown, DEFAULTS.attackCooldown)
	local speed = coerce(args.speed, DEFAULTS.speed)

	-- Library install stays OUTSIDE the make's undo recording (shared infrastructure).
	local libOk, libNote = RuntimeInstaller.ensureInstalled(
		if type(context) == "table" then context.config else nil,
		{ "NpcAI" }
	)
	local function doMake()
		m:SetAttribute("NpcDamage", damage)
		m:SetAttribute("NpcDetectRange", detectRange)
		m:SetAttribute("NpcAttackRange", attackRange)
		m:SetAttribute("NpcAttackCooldown", attackCooldown)
		m:SetAttribute("NpcState", "idle")
		local hum = m:FindFirstChildOfClass("Humanoid")
		if hum ~= nil then
			(hum :: Humanoid).WalkSpeed = speed
		end
		-- a posing rig anchors its root; an NPC must be free to walk (Humanoid:MoveTo)
		local hrp = m:FindFirstChild("HumanoidRootPart")
		if hrp ~= nil and hrp:IsA("BasePart") then
			(hrp :: BasePart).Anchored = false
		end
		local old = m:FindFirstChild("NpcAI")
		if old ~= nil then
			old:Destroy()
		end
		local s = Instance.new("Script")
		s.Name = "NpcAI"
		s.Source = if libOk then RuntimeInstaller.launcherSource("NpcAI") else AI_SOURCE
		s:SetAttribute("StudioAgentGenerated", true) -- identity marker: game_pull excludes on this
		s.Parent = m
	end
	if RunService:IsEdit() then
		local rid = ChangeHistoryService:TryBeginRecording("make_npc")
		doMake()
		if rid ~= nil then
			ChangeHistoryService:FinishRecording(rid, Enum.FinishRecordingOperation.Commit)
		end
	else
		doMake()
	end

	local msg = string.format(
		"make_npc OK: %s is now an enemy NPC -- server AI idle -> chase (MoveTo within %.0f studs) -> attack "
			.. "(%d dmg every %.1fs within %.0f studs) -> dead (Health 0). WalkSpeed %.0f. The NpcState "
			.. "attribute tracks its state; the player's hit-detecting weapon (#4) kills it. Server-authoritative.",
		m.Name,
		detectRange,
		damage,
		attackCooldown,
		attackRange,
		speed
	)
	msg = msg
		.. " NOTE: uses direct Humanoid:MoveTo (no obstacle pathfinding) + no swing animation yet -- "
		.. "PathfindingService, patrol routes, and NPC animations are later upgrades."
	msg ..= " [" .. (if libOk
		then libNote
		else "runtime library unavailable — stamped the legacy full source (" .. libNote .. ")") .. "]"
	return msg, false
end

Npc.descriptors = {
	{
		name = "make_npc",
		description = "Turn a rig (a Model with a Humanoid + HumanoidRootPart, e.g. from spawn_rig) into an "
			.. "ENEMY NPC with server-side AI: a state machine idle -> chase (MoveTo the nearest player within "
			.. "detectRange) -> attack (TakeDamage the player every attackCooldown within attackRange) -> dead "
			.. "(when its own Humanoid Health hits 0, e.g. killed by the player's #4 weapon). Writes the config "
			.. "as Attributes (NpcDamage/NpcDetectRange/NpcAttackRange/NpcAttackCooldown + NpcState) + a server "
			.. "NpcAI Script. Server-authoritative. Inputs: rig (required path), damage? (15), detectRange? "
			.. "(40), attackRange? (6), attackCooldown? (1.5s), speed? (WalkSpeed, 12). Gives the items "
			.. "(#1-4) something to fight.",
		inputSchema = {
			type = "object",
			properties = {
				rig = {
					type = "string",
					description = "Path to the rig Model (Humanoid + HumanoidRootPart).",
				},
				damage = { type = "number", description = "Damage per attack (default 15)." },
				detectRange = {
					type = "number",
					description = "Studs within which it notices + chases a player (default 40).",
				},
				attackRange = {
					type = "number",
					description = "Studs within which it stops + attacks (default 6).",
				},
				attackCooldown = {
					type = "number",
					description = "Seconds between attacks (default 1.5).",
				},
				speed = { type = "number", description = "Humanoid WalkSpeed (default 12)." },
			},
			required = { "rig" },
		},
		destructive = true,
		run = runMake,
	},
} :: { Descriptor }

return Npc
