--!strict
-- Item hit detection (roadmap #4): bind_hitbox(tool, damage?, reach?) makes the item DEAL DAMAGE on its
-- ACTIVE WINDOW (#3). Architecture = client-request -> server-execute (the netcode foundation): a client
-- ItemHitClient fires a shared RemoteEvent when #3's StateChanged hits 'active'; a server ItemHitServer does
-- the AUTHORITATIVE hitbox sweep (a reach-radius region around the Handle) + TakeDamage on every non-wielder
-- Humanoid, once per swing -- gated by a server-authoritative COOLDOWN (the netcode foundation's first
-- validation: rejects FireServer spam; algorithm = HitValidator, unit-tested in HitValidatorSpec). Heavier
-- netcode (lag-comp rewind / per-limb / reconciliation) is the later dedicated effort. Destructive
-- (DataModel writes); RELAY; parent-only.
-- See docs/superpowers/specs/2026-06-26-item-hit-detection-design.md.

local ChangeHistoryService = game:GetService("ChangeHistoryService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Path = require(script.Parent.Path)
local HitValidator = require(script.Parent.Parent.HitValidator)

local ItemHit = {}

export type Descriptor = {
	name: string,
	description: string,
	inputSchema: { [string]: any },
	destructive: boolean,
	run: (input: any, context: any) -> (any, boolean),
}

local REMOTE_NAME = "StudioAgentItemHit"

-- CLIENT: on the ACTIVE window (#3's StateChanged), request a server hit. ASCII-only.
local CLIENT_SOURCE = [==[
-- ItemHitClient (auto-generated by bind_hitbox) -- CLIENT: request a server-authoritative hit on the active
-- window. The server does the actual sweep + damage; this only signals the swing moment.
local Tool = script.Parent
local rs = game:GetService("ReplicatedStorage")
local remote = rs:WaitForChild("StudioAgentItemHit", 10)
local sc = Tool:FindFirstChild("StateChanged")
if sc and remote then
	sc.Event:Connect(function(state)
		if state == "active" then
			remote:FireServer(Tool)
		end
	end)
end
]==]

-- SERVER: the AUTHORITATIVE hitbox sweep + damage. ASCII-only.
local SERVER_SOURCE = [==[
-- ItemHitServer (auto-generated by bind_hitbox) -- SERVER: authoritative hitbox + damage on a hit request,
-- gated by a SERVER-AUTHORITATIVE COOLDOWN (the netcode foundation's first validation: rejects FireServer
-- spam faster than the swing cooldown so a client can't deal damage at an arbitrary rate). The cooldown
-- algorithm mirrors HitValidator.check (unit-tested in HitValidatorSpec). Heavier netcode (lag-comp rewind,
-- per-limb, reconciliation) layers on top of this seam later.
local Tool = script.Parent
local rs = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local remote = rs:WaitForChild("StudioAgentItemHit", 10)
if not remote then
	return
end
local lastHit = {} -- [player] = os.clock() of last ACCEPTED hit (per-player cooldown state)
Players.PlayerRemoving:Connect(function(p)
	lastHit[p] = nil
end)
remote.OnServerEvent:Connect(function(player, tool)
	if tool ~= Tool then
		return
	end
	local char = player.Character
	local handle = Tool:FindFirstChild("Handle")
	if not (char and handle and Tool.Parent == char) then
		return
	end
	-- AUTHORITATIVE VALIDATION: reject a request faster than the swing cooldown. A rejected (spam)
	-- request does NOT advance the window, so a later legitimate swing is never starved.
	local cooldown = tonumber(Tool:GetAttribute("HitCooldown")) or 0.4
	if cooldown < 0 then
		cooldown = 0
	end
	local now = os.clock()
	local prev = lastHit[player]
	if prev ~= nil and (now - prev) < cooldown then
		return -- rejected: on cooldown (anti-spam)
	end
	lastHit[player] = now
	local damage = tonumber(Tool:GetAttribute("HitDamage")) or 25
	local reach = tonumber(Tool:GetAttribute("HitReach")) or 6
	local hitEvent = Tool:FindFirstChild("Hit")
	-- Find the CLOSEST struck part per victim Humanoid. On an R15 rig each limb is a separate part, so the
	-- closest part's name is the struck LIMB -- reported to the Hit event so VFX/knockback can be
	-- limb-aware (and as the data foundation for later per-limb damage/dismemberment, a design call).
	local struck = {}
	for _, p in workspace:GetPartBoundsInRadius(handle.Position, reach) do
		local model = p:FindFirstAncestorOfClass("Model")
		local hum = model and model:FindFirstChildOfClass("Humanoid")
		if hum and model ~= char then
			local d = (p.Position - handle.Position).Magnitude
			local cur = struck[hum]
			if cur == nil or d < cur.dist then
				struck[hum] = { model = model, part = p, dist = d }
			end
		end
	end
	for hum, info in struck do
		hum:TakeDamage(damage)
		if hitEvent then
			pcall(function()
				hitEvent:Fire(info.model, damage, info.part.Name)
			end)
		end
	end
end)
]==]

local function coerce(v: any, default: number): number
	if type(v) ~= "number" or v ~= v then
		return default
	end
	if v < 0 then
		return 0
	end
	return v
end

local function findTool(args: any): (Tool?, string?)
	if type(args.tool) ~= "string" or args.tool == "" then
		return nil, "bind_hitbox requires { tool = <path to a Tool>, damage?, reach? }"
	end
	local inst = Path.resolve(args.tool)
	if inst == nil or not inst:IsA("Tool") then
		return nil, "'" .. tostring(args.tool) .. "' is not a Tool (run make_tool first)"
	end
	return inst :: Tool, nil
end

local function ensureRemote()
	local r = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
	if r == nil or not r:IsA("RemoteEvent") then
		if r ~= nil then
			r:Destroy()
		end
		local ev = Instance.new("RemoteEvent")
		ev.Name = REMOTE_NAME
		ev.Parent = ReplicatedStorage
	end
end

local function ensureChild(tool: Tool, name: string, className: string, src: string)
	local old = tool:FindFirstChild(name)
	if old ~= nil then
		old:Destroy()
	end
	local s = Instance.new(className)
	s.Name = name
	;(s :: any).Source = src
	s.Parent = tool
end

local function ensureHitEvent(tool: Tool)
	local ev = tool:FindFirstChild("Hit")
	if ev == nil or not ev:IsA("BindableEvent") then
		if ev ~= nil then
			ev:Destroy()
		end
		local b = Instance.new("BindableEvent")
		b.Name = "Hit"
		b.Parent = tool
	end
end

local function runBind(input: any, _context: any): (any, boolean)
	local args = if type(input) == "table" then input else {}
	local tool, terr = findTool(args)
	if tool == nil then
		return terr, true
	end
	local theTool = tool :: Tool
	if theTool:FindFirstChild("Handle") == nil then
		return "bind_hitbox: the Tool has no Handle (run make_tool first)", true
	end
	local damage = coerce(args.damage, 25)
	local reach = coerce(args.reach, 6)
	local cooldown = HitValidator.coerceCooldown(args.cooldown)
	local hasBehavior = theTool:FindFirstChild("StateChanged") ~= nil

	local function doBind()
		theTool:SetAttribute("HitDamage", damage)
		theTool:SetAttribute("HitReach", reach)
		theTool:SetAttribute("HitCooldown", cooldown)
		ensureRemote()
		ensureHitEvent(theTool)
		ensureChild(theTool, "ItemHitClient", "LocalScript", CLIENT_SOURCE)
		ensureChild(theTool, "ItemHitServer", "Script", SERVER_SOURCE)
	end
	if RunService:IsEdit() then
		local rid = ChangeHistoryService:TryBeginRecording("bind_hitbox")
		doBind()
		if rid ~= nil then
			ChangeHistoryService:FinishRecording(rid, Enum.FinishRecordingOperation.Commit)
		end
	else
		doBind()
	end

	local msg = string.format(
		"bind_hitbox OK: %s deals %d damage within %.1f studs on its ACTIVE window. Flow: the client "
			.. "(ItemHitClient) fires the %s RemoteEvent when #3's StateChanged hits 'active'; the server "
			.. "(ItemHitServer) FIRST validates a server-authoritative %.2fs cooldown (rejects FireServer spam), "
			.. "then sweeps a %.1f-stud radius around the Handle and TakeDamage's every non-wielder Humanoid "
			.. "once per swing (server-AUTHORITATIVE). A `Hit` BindableEvent fires per target (model, damage, "
			.. "limb) -- limb = the closest struck part's name (R15 per-limb) -- for VFX/knockback.",
		theTool.Name,
		damage,
		reach,
		REMOTE_NAME,
		cooldown,
		reach
	)
	if not hasBehavior then
		msg = msg
			.. " WARNING: the Tool has no StateChanged yet -- run bind_behavior(tool, ...) first or nothing "
			.. "fires (the hit triggers on the behavior's active window)."
	end
	msg = msg
		.. " NOTE: the server-authoritative COOLDOWN (anti-spam request validation) is now the first netcode "
		.. "layer at this seam; lag-compensation rewind / per-limb hits / reconciliation are the later "
		.. "dedicated netcode effort built on top of it."
	return msg, false
end

ItemHit.descriptors = {
	{
		name = "bind_hitbox",
		description = "Give a handheld Tool HIT DETECTION on its #3 active window: on the swing's active "
			.. "window it deals damage to nearby Humanoids. Architecture = client-request -> server-execute "
			.. "(server-authoritative): writes HitDamage/HitReach Attributes + a client ItemHitClient (fires a "
			.. "shared RemoteEvent when StateChanged=='active') + a server ItemHitServer (sweeps a reach-radius "
			.. "region around the Handle and TakeDamage's every non-wielder Humanoid once per swing) + a `Hit` "
			.. "BindableEvent per target. The server gates each request behind a server-authoritative COOLDOWN "
			.. "(rejects FireServer spam) before sweeping. Run AFTER bind_behavior (it triggers on the active "
			.. "window). Inputs: tool (required path), damage? (default 25), reach? (studs, default 6), "
			.. "cooldown? (seconds between accepted hits, default 0.4). Heavier netcode (lag-comp rewind / "
			.. "per-limb) is a later dedicated effort built on this seam.",
		inputSchema = {
			type = "object",
			properties = {
				tool = { type = "string", description = "Path to the Tool (from make_tool)." },
				damage = { type = "number", description = "Damage per hit (default 25)." },
				reach = {
					type = "number",
					description = "Hitbox radius in studs around the Handle (default 6).",
				},
				cooldown = {
					type = "number",
					description = "Server-authoritative min seconds between accepted hits (anti-spam; default "
						.. "0.4, 0 = off).",
				},
			},
			required = { "tool" },
		},
		destructive = true,
		run = runBind,
	},
} :: { Descriptor }

return ItemHit
