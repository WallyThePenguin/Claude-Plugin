# Build artifacts
*.rbxm
*.rbxl
*.rbxlx.lock

# Rojo / toolchain
/sourcemap.json

# Dependencies
/node_modules/
/DevPackages/

# Forest-installed trees. Never commit them: forest.json + forest-lock.json
# reproduce the exact tree, integrity-hash for integrity-hash, via `forest install`.
#
# These MUST be anchored paths, not a bare `Packages/`. This repo has
# core.ignorecase=true (Windows), so a bare `Packages/` also matches the
# `packages/` SOURCE directory and silently ignores the entire workspace.
/game/Packages/
/game/*/Packages/
/packages/*/Packages/
/packages/*/src/Packages/
/spike/Packages/

# Secrets — never commit proxy keys or OAuth tokens
.env
.env.local
proxy/config.yaml
proxy/auth/
proxy/data/
sidecar/build/
sidecar/*.spec
sidecar/*.png
*.key

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
.vscode/
assets/reference/*.glb

# Reference-image cache (downloaded study material, licenses vary - never ship)
sidecar/refcache/

# Docs-grounding cache (creator-docs clone + API dumps - re-fetched on demand)
sidecar/docscache/

# Sidecar-loop transcripts (JSONL run logs)
sidecar/loops/
