{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Category Build Guide",
  "type": "object",
  "required": ["module", "version", "system_module", "tiers"],
  "properties": {
    "module": { "type": "string" },
    "version": { "type": "string" },
    "date": { "type": "string" },
    "system_module": { "type": "string" },
    "rubric_version": { "type": "string" },
    "overview": { "type": "string" },
    "killer_systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "what": { "type": "string" },
          "how": { "type": "string" }
        }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tier", "steps"],
        "properties": {
          "tier": { "type": "string", "enum": ["baseline", "good", "exceptional"] },
          "goal": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "instruction"],
              "properties": {
                "id": { "type": "string" },
                "order_index": { "type": "number" },
                "instruction": { "type": "string" },
                "addresses_criteria": { "type": "array", "items": { "type": "string" } },
                "tools": { "type": "array", "items": { "type": "string" } },
                "pitfalls": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "common_pitfalls": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "properties": {
        "sources": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "string" },
        "coverage": {
          "type": "object",
          "properties": {
            "criteria_total": { "type": "number" },
            "criteria_addressed": { "type": "number" },
            "uncovered": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
